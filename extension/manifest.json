{
  "manifest_version": 3,
  "name": "Quick Web Clip",
  "version": "1.5.1",
  "description": "Save the current page to an Obsidian vault as a Markdown note.",
  "browser_specific_settings": {
    "gecko": {
      "id": "quick-web-clip@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["nativeMessaging", "menus", "activeTab", "scripting", "storage", "notifications"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Save page to Obsidian",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "clip-default": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Save the current page to the default Obsidian destination"
    }
  },
  "options_ui": {
    "page": "options/options.html"
  }
}
